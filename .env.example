# Firebase is OPTIONAL. Without it the app runs fully in guest mode and
# persists routines to localStorage. Fill these in only if you want accounts
# and cross-device sync.
#
# Get these from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
# Enable Authentication (Email/Password) and Firestore in that project.
#
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# OPTIONAL, for maintainers only: lets `npm run sync:hevy` refresh the Hevy
# exercise snapshot. The app itself never reads this; users enter their own
# Hevy key in Settings.
HEVY_API_KEY=
